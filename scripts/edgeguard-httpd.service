[Unit]
Description=EdgeGuard HTTP Remote Access Service
After=edgeguard.service network-online.target
Wants=edgeguard.service network-online.target

[Service]
Type=simple
ExecStart=/imx6ull/app/edgeguard_httpd --port 8080 --status /tmp/edgeguard_status.json --cmd /tmp/edgeguard_cmd.json
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target